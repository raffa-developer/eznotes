{
  "name": "eznotes",
  "version": "0.5.2",
  "description": "Lecture notes that listen, filter, and structure themselves.",
  "main": "./out/main/index.js",
  "author": "Rafael",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:node": "node scripts/fetch-node.mjs",
    "pack": "npm run fetch:node && npm run build && electron-builder --dir",
    "dist": "npm run fetch:node && npm run build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "date-fns": "^4.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "sherpa-onnx-node": "1.13.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "app.eznotes",
    "productName": "ezNotes",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/node/node.exe",
        "to": "node/node.exe"
      },
      {
        "from": "vendor/node/LICENSE",
        "to": "node/LICENSE"
      },
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "src/main/diarizer/diarization-worker.cjs",
        "to": "diarizer/diarization-worker.cjs"
      },
      {
        "from": "node_modules/sherpa-onnx-node",
        "to": "diarizer/node_modules/sherpa-onnx-node"
      },
      {
        "from": "node_modules/sherpa-onnx-win-x64",
        "to": "diarizer/node_modules/sherpa-onnx-win-x64"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "electron-winstaller@5.4.0": true
  }
}
