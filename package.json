{
  "name": "eznotes",
  "version": "0.6.1",
  "description": "Lecture notes that listen, filter, and structure themselves.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Rafael Gonçalves",
    "email": "raffa-developer@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:sherpa": "node scripts/fetch-sherpa.mjs",
    "pack": "npm run fetch:sherpa && npm run build && electron-builder --dir",
    "dist": "npm run fetch:sherpa && npm run build && electron-builder",
    "dist:win": "node scripts/fetch-sherpa.mjs win-x64 && npm run build && electron-builder --win",
    "dist:mac": "node scripts/fetch-sherpa.mjs darwin-x64 darwin-arm64 && npm run build && electron-builder --mac --x64 --arm64",
    "dist:linux": "node scripts/fetch-sherpa.mjs linux-x64 linux-arm64 && npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "date-fns": "^4.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "sherpa-onnx-node": "1.13.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "app.eznotes",
    "productName": "ezNotes",
    "directories": {
      "output": "release"
    },
    "afterSign": "scripts/notarize.cjs",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      },
      {
        "from": "src/main/diarizer/diarization-worker.cjs",
        "to": "diarizer/diarization-worker.cjs"
      },
      {
        "from": "node_modules/sherpa-onnx-node",
        "to": "diarizer/node_modules/sherpa-onnx-node"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png",
      "extraResources": [
        {
          "from": "vendor/sherpa/sherpa-onnx-win-x64",
          "to": "diarizer/node_modules/sherpa-onnx-win-x64"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "resources/icon-1024.png",
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "vendor/sherpa/sherpa-onnx-darwin-x64",
          "to": "diarizer/node_modules/sherpa-onnx-darwin-x64"
        },
        {
          "from": "vendor/sherpa/sherpa-onnx-darwin-arm64",
          "to": "diarizer/node_modules/sherpa-onnx-darwin-arm64"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "ezNotes records a lecture when you start a recording."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "resources/icon-1024.png",
      "extraResources": [
        {
          "from": "vendor/sherpa/sherpa-onnx-linux-x64",
          "to": "diarizer/node_modules/sherpa-onnx-linux-x64"
        },
        {
          "from": "vendor/sherpa/sherpa-onnx-linux-arm64",
          "to": "diarizer/node_modules/sherpa-onnx-linux-arm64"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "electron-winstaller@5.4.0": true
  }
}
